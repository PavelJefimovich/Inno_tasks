CREATE OR REPLACE PROCEDURE PROC_LOAD_AIRPORTS()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    CREATE OR REPLACE TABLE STG.AIRPORTS AS
    SELECT DISTINCT
        TRIM(ARRIVAL_AIRPORT) AS AIRPORT_NAME,
        TRIM(ARRIVAL_AIRPORT) AS AIRPORT_CODE
    FROM RAW.AIRLINE_DATA_RAW
    WHERE ARRIVAL_AIRPORT IS NOT NULL;
    
    RETURN 'STG.AIRPORTS loaded';
END;
$$;
