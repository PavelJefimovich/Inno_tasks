CREATE OR REPLACE PROCEDURE PROC_LOAD_FLIGHTS()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    INSERT INTO STG.FLIGHTS (
        PASSENGER_ID,
        ARRIVAL_AIRPORT_CODE,
        DEPARTURE_DATE,
        FLIGHT_STATUS,
        TICKET_TYPE
    )
    SELECT
        PASSENGER_ID,
        ARRIVAL_AIRPORT,
        TO_DATE(DEPARTURE_DATE, 'MM/DD/YYYY') AS DEPARTURE_DATE,
        FLIGHT_STATUS,
        TICKET_TYPE
    FROM RAW.AIRLINE_DATA_RAW;
    
    RETURN 'STG.FLIGHTS loaded';
END;
$$;
