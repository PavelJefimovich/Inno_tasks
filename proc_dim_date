CREATE OR REPLACE PROCEDURE PROC_DIM_DATE()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    CREATE OR REPLACE TABLE MART.DIM_DATE AS
    SELECT
        ROW_NUMBER() OVER (ORDER BY DEPARTURE_DATE) AS DATE_SK,
        DEPARTURE_DATE AS FULL_DATE,
        EXTRACT(YEAR FROM DEPARTURE_DATE) AS YEAR,
        EXTRACT(MONTH FROM DEPARTURE_DATE) AS MONTH,
        EXTRACT(DAY FROM DEPARTURE_DATE) AS DAY,
        CURRENT_TIMESTAMP() AS LOAD_TS
    FROM STG.FLIGHTS;
    
    RETURN 'DIM_DATE loaded';
END;
$$;
