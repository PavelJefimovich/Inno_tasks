CREATE OR REPLACE PROCEDURE PROC_FACT_FLIGHTS()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    INSERT INTO MART.FACT_FLIGHTS (
        PASSENGER_SK,
        AIRPORT_SK,
        DATE_SK,
        FLIGHT_STATUS,
        TICKET_TYPE,
        LOAD_TS
    )
    SELECT
        p.PASSENGER_SK,
        a.AIRPORT_SK,
        d.DATE_SK,
        f.FLIGHT_STATUS,
        f.TICKET_TYPE,
        CURRENT_TIMESTAMP()
    FROM STG.FLIGHTS f
    JOIN MART.DIM_PASSENGER p
        ON f.PASSENGER_ID = p.PASSENGER_ID
    JOIN MART.DIM_AIRPORT a
        ON f.ARRIVAL_AIRPORT_CODE = a.AIRPORT_CODE
    JOIN MART.DIM_DATE d
        ON f.DEPARTURE_DATE = d.FULL_DATE;
    
    RETURN 'FACT_FLIGHTS loaded';
END;
$$;
