CREATE OR REPLACE PROCEDURE PROC_DIM_AIRPORT()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    CREATE OR REPLACE TABLE MART.DIM_AIRPORT AS
    SELECT
        ROW_NUMBER() OVER (ORDER BY AIRPORT_CODE) AS AIRPORT_SK,
        AIRPORT_NAME,
        AIRPORT_CODE,
        '' AS AIRPORT_COUNTRY_CODE,
        '' AS COUNTRY_NAME,
        '' AS AIRPORT_CONTINENT,
        '' AS CONTINENTS,
        CURRENT_TIMESTAMP() AS LOAD_TS
    FROM STG.AIRPORTS;
    
    RETURN 'DIM_AIRPORT loaded';
END;
$$;
