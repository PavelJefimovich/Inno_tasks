CREATE OR REPLACE PROCEDURE PROC_LOAD_PASSENGERS()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    INSERT INTO STG.PASSENGERS (PASSENGER_ID, FIRST_NAME, LAST_NAME, GENDER, AGE, NATIONALITY, PASSENGER_STATUS)
    SELECT DISTINCT
        PASSENGER_ID,
        FIRST_NAME,
        LAST_NAME,
        GENDER,
        AGE,
        NATIONALITY,
        PASSENGER_STATUS
    FROM RAW.AIRLINE_DATA_RAW
    WHERE PASSENGER_ID IS NOT NULL;
    
    RETURN 'STG.PASSENGERS loaded';
END;
$$;
