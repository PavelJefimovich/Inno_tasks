CREATE OR REPLACE PROCEDURE PROC_DIM_PASSENGER()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    CREATE OR REPLACE TABLE MART.DIM_PASSENGER AS
    SELECT
        ROW_NUMBER() OVER (ORDER BY PASSENGER_ID) AS PASSENGER_SK,
        PASSENGER_ID,
        FIRST_NAME,
        LAST_NAME,
        GENDER,
        AGE,
        NATIONALITY,
        PASSENGER_STATUS,
        CURRENT_TIMESTAMP() AS LOAD_TS
    FROM STG.PASSENGERS;
    
    RETURN 'DIM_PASSENGER loaded';
END;
$$;
